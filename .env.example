# Never commit a real key. These values are read only by server/index.mjs.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Conservative local controls. Choose your own explicit hard cap; the bridge
# never permits more than $400, and these example values cap a session at $5.
RELAYLINGS_HARD_CAP_USD=5
RELAYLINGS_PRIOR_SPEND_USD=0
RELAYLINGS_SESSION_CAP_USD=5
RELAYLINGS_MAX_COST_PER_CALL_USD=0.25
OPENROUTER_MAX_TOKENS=1000

# Optional: path to a local Markdown ledger with the two documented observed and
# conservative spend fields. Keep the ledger ignored and outside public commits.
RELAYLINGS_PROJECT_LEDGER_PATH=

# Codex and Claude CLI helpers remain off unless explicitly enabled locally.
ENABLE_CLI_BRIDGE=0

# Usually generated automatically by `npm run dev:connected`. If starting the
# bridge and Vite separately, set the same random 32+ character value for both.
RELAYLINGS_BRIDGE_TOKEN=
